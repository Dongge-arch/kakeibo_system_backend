# Home Kakeibo Armbian batch environment example.
# 実際の値は /etc/home-kakeibo-batch.env に配置してください。

KAKEIBO_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
KAKEIBO_DATABASE_INITIALIZE=false

# AIレシート登録をバッチから使う場合だけ設定します。
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.5-flash-lite

# API共通キーを使う処理がある場合だけ設定します。
KAKEIBO_API_KEY=replace-me
